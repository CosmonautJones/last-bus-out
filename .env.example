# Copy to .env and fill in. NEVER commit .env (it's in .gitignore).
# Provider: watsonx (IBM watsonx.ai, Dallas) | ollama (Granite open weights locally) | mock (offline fallback, not Granite)
LBO_LLM_PROVIDER=watsonx

# watsonx.ai > home page > Developer access (choose the "watsonx Hackathon Sandbox" project, region Dallas)
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Pick a Granite model ID listed in Prompt Lab. Do NOT use llama-3-405b, mistral-medium-2505 or mistral-small-3-1-24b (out of scope).
GRANITE_MODEL_ID=ibm/granite-4-h-small

# Local backup: `ollama pull granite3.3:8b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=granite3.3:8b

# Optional: Census API key (small queries work without one)
CENSUS_API_KEY=
